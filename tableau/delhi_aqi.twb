<?xml version='1.0' encoding='utf-8' ?>
<!-- Tableau workbook for the Delhi Air Quality & Health Dashboard.
     Data: data/aqi_daily_clean.csv (daily AQI, 1 Jun - 10 Nov 2026,
     Anand Vihar, RK Puram, Najafgarh).
     Open in Tableau Desktop / Tableau Public. On first open, Tableau
     may ask you to point the data source at the CSV on your own
     computer — pick data/aqi_daily_clean.csv in this project.
     Worksheets: "Monthly AQI Trend", "Station Comparison".
     Dashboard: "Delhi AQI Dashboard" (both worksheets + a filter). -->
<workbook version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
  </preferences>
  <datasources>
    <datasource caption='aqi_daily_clean' inline='true' name='federated.1' version='18.1'>
      <connection class='federated' driver='' name=''>
        <named-connections>
          <named-connection caption='aqi_daily_clean' name='textscan.1'>
            <connection class='textscan' directory='' filename='data/aqi_daily_clean.csv' />
          </named-connection>
        </named-connections>
        <relation name='aqi_daily_clean' table='[aqi_daily_clean.csv]' type='text' />
        <object-graph>
          <objects>
            <object caption='aqi_daily_clean' id='aqi_daily_clean' name='aqi_daily_clean' table='[aqi_daily_clean.csv]' type='table' />
          </objects>
        </object-graph>
      </connection>
      <column caption='Station' datatype='string' name='[station]' role='dimension' type='nominal' />
      <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
      <column caption='PM2.5' datatype='real' name='[pm2_5]' role='measure' type='quantitative' />
      <column caption='PM10' datatype='real' name='[pm10]' role='measure' type='quantitative' />
      <column caption='NO2' datatype='real' name='[nitrogen_dioxide]' role='measure' type='quantitative' />
      <column caption='SO2' datatype='real' name='[sulphur_dioxide]' role='measure' type='quantitative' />
      <column caption='Ozone (8h max)' datatype='real' name='[ozone]' role='measure' type='quantitative' />
      <column caption='AQI' datatype='integer' name='[aqi]' role='measure' type='quantitative' />
      <column caption='Dominant Pollutant' datatype='string' name='[dominant_pollutant]' role='dimension' type='nominal' />
      <column caption='AQI Category' datatype='string' name='[aqi_category]' role='dimension' type='nominal' />
      <column caption='Latitude' datatype='real' name='[latitude]' role='measure' type='quantitative' />
      <column caption='Longitude' datatype='real' name='[longitude]' role='measure' type='quantitative' />
      <column caption='Number of Records' datatype='integer' name='[Number of Records]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Avg AQI' datatype='integer' name='[calc_Avg AQI]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([aqi])' />
      </column>
      <column caption='Advisory Days' datatype='integer' name='[calc_Advisory Days]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [aqi] &gt; 200 THEN 1 ELSE 0 END)' />
      </column>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Monthly AQI Trend'>
      <table>
        <view>
          <datasource-dependencies datasource='federated.1'>
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[aqi]' role='measure' type='quantitative' />
            <column datatype='string' name='[station]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <rows>[date]</rows>
          <cols>AVG([aqi])</cols>
          <detail>[station]</detail>
        </view>
      </table>
      <layout-options>
        <title>
          <formatted-text><run>Monthly AQI Trend — average AQI by month and station</run></formatted-text>
        </title>
      </layout-options>
    </worksheet>
    <worksheet name='Station Comparison'>
      <table>
        <view>
          <datasource-dependencies datasource='federated.1'>
            <column datatype='string' name='[station]' role='dimension' type='nominal' />
            <column datatype='integer' name='[aqi]' role='measure' type='quantitative' />
            <column datatype='string' name='[aqi_category]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <rows>[station]</rows>
          <cols>AVG([aqi])</cols>
          <color>[aqi_category]</color>
        </view>
      </table>
      <layout-options>
        <title>
          <formatted-text><run>Station Comparison — average AQI by station (RK Puram worst)</run></formatted-text>
        </title>
      </layout-options>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Delhi AQI Dashboard'>
      <layout-options>
        <title>
          <formatted-text><run>Delhi Air Quality &amp; Health Dashboard — Jun–Nov 2026</run></formatted-text>
        </title>
      </layout-options>
      <zones>
        <zone h='100000' id='1' type='layout-basic' w='100000' x='0' y='0'>
          <zone h='48000' id='2' type='layout-flow' w='100000' x='0' y='0'>
            <zone h='48000' id='3' type='layout-basic' w='50000' x='0' y='0'>
              <zone h='48000' id='4' type='worksheet' w='50000' x='0' y='0' name='Monthly AQI Trend' />
            </zone>
            <zone h='48000' id='5' type='layout-basic' w='50000' x='50000' y='0'>
              <zone h='48000' id='6' type='worksheet' w='50000' x='0' y='0' name='Station Comparison' />
            </zone>
          </zone>
        </zone>
      </zones>
    </dashboard>
  </dashboards>
  <windows>
    <window class='worksheet' name='Monthly AQI Trend' />
    <window class='worksheet' name='Station Comparison' />
    <window class='dashboard' name='Delhi AQI Dashboard' />
  </windows>
</workbook>
